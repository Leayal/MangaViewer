<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
	<RollForward>LatestMajor</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Leayal.MangaViewer</RootNamespace>
    <Authors>Dramiel Leayal</Authors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="WebPage\css\anim_loading.css" />
    <None Remove="WebPage\css\home.css" />
    <None Remove="WebPage\index.html" />
    <None Remove="WebPage\js\home.js" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebPage\css\anim_loading.css" />
    <EmbeddedResource Include="WebPage\css\home.css" />
    <EmbeddedResource Include="WebPage\index.html" />
    <EmbeddedResource Include="WebPage\js\home.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="4.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SharpCompress" Version="0.50.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultipleReaderFileStream-DotNet\MultipleReaderFileStream-DotNet.csproj" />
  </ItemGroup>

</Project>